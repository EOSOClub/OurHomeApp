<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The *Policy ignores below silence Android Studio's Play Policy
         Insights. Our Home is never published on Google Play (each household's
         server builds its own copy), so Play's review rules don't apply. -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: asked at runtime on first sign-in (request reminders). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Scan inventory tags. Not required, so phones without NFC can still install. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <!-- Install the server's app updates (Profile → Android app). Android still
         asks the user once ("Install unknown apps") and confirms each install. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="RequestInstallPackagesPolicy" />
    <!-- Presence and store reminders (location/Geofences): asked from Profile →
         Location only after the member turns sharing on. Geofences need precise
         location "all the time"; nothing is tracked in between, Android only
         reports arriving at and leaving the household's map places. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:ignore="BackgroundLocationPolicy" />
    <!-- Android drops geofences on reboot; this registers them again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Live location checks (location/LiveChecks): a short location foreground
         service, with its notification showing the whole time. Only for members
         who allowed live checks on their Profile. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Ringing this phone (notifications/Ring): a supervising adult's ring plays
         the alarm sound for half a minute in a short media foreground service,
         and vibrates. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- App usage (notifications/UsageReport): only while an adult who looks
         after this member shares it, and only once the member allows Usage
         access in Android's settings. Never asked for otherwise. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Battery "Unrestricted" (notifications/BatteryAccess): only asked when the
         member taps Allow on Profile; Android shows its own question. Lets the
         hourly check, pushes and Stay connected run on time. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Stay connected (notifications/StayConnected): a foreground service that
         keeps one connection to the household's server, only while the member
         turned it on in Profile. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Whether the phone is on Wi-Fi, mobile data or nothing (notifications/
         PhoneCheckIn), sent only while an adult looks after its member, so a
         phone that goes quiet can be told apart from one out of signal. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Task photo proof (ui/TaskCamera): a photo taken inside Our Home when a
         task is sent for a check, kept in memory only (never the gallery).
         Asked the first time someone taps Take a photo. Not required, so
         phones without a camera still install (they send a note instead). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- App usage names apps the way the phone does: Android 11+ only lets an
         app see others it declares, so these are the apps a person can open
         (and the home screen, which isn't counted). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- The close guard reads Settings' own "Force stop" text, in the
             phone's language (notifications/CloseGuard). -->
        <package android:name="com.android.settings" />
    </queries>

    <!-- network_security_config is generated into build/ (build.gradle.kts),
         which Android Studio's manifest check can't see. -->
    <!--suppress AndroidDomInspection -->
    <application
        android:name=".OurHomeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OurHome">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A setup link's "Open Our Home" button (web /get-app/<token>):
                 ourhome://setup?username=&server= fills in the sign-in screen
                 (data/ChildSetup.kt setupPrefill). Nothing else is done with it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ourhome" android:host="setup" />
            </intent-filter>
        </activity>

        <!-- The blocked screen over an app a supervising adult blocked
             (notifications/AppBlocker). Its own task, out of Recents. -->
        <activity
            android:name=".notifications.AppBlockedActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="" />

        <!-- The parent PIN screen over a protected Settings screen
             (notifications/CloseGuard). Its own task, out of Recents. -->
        <activity
            android:name=".notifications.ParentPinActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- Tags scanned while the app isn't open. Invisible: it looks the tag up,
             then posts the quick notification or opens MainActivity, and finishes.
             Never shows over the lock screen (no showWhenLocked). -->
        <activity
            android:name=".nfc.QuickScanActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.OurHome.Invisible">
            <!-- Tags written by this app: always Our Home (+ the Android
                 Application Record on the tag), so no app chooser. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="ourhome" android:host="tag" />
            </intent-filter>
            <!-- Old Home Assistant tags, until they're rewritten (HA may compete). -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="https" android:host="www.home-assistant.io" android:pathPrefix="/tag/" />
            </intent-filter>
            <!-- Blank / unrecognised tags, so a new tag can be set up from a scan. -->
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data android:name="android.nfc.action.TECH_DISCOVERED" android:resource="@xml/nfc_tech_filter" />
        </activity>

        <!-- Quick-scan notification buttons. Not exported: only our own
             PendingIntents can reach it. -->
        <receiver
            android:name=".notifications.QuickScanReceiver"
            android:exported="false" />

        <!-- Geofence events from Play services, through our own mutable
             PendingIntent. Not exported. -->
        <receiver
            android:name=".location.GeofenceReceiver"
            android:exported="false" />

        <!-- Re-registers geofences after a reboot or an app update. Exported
             only because the system sends BOOT_COMPLETED; it just schedules a
             sync and reads nothing from the intent but its action. -->
        <receiver
            android:name=".location.GeofenceRestoreReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- A live location check on this phone's member, started by the
             server's push. Not exported: only our own push handler and the
             notification's Stop (unlock required) reach it. -->
        <service
            android:name=".location.LiveCheckService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- A supervising adult ringing this phone, started by the server's push.
             Not exported: only our own push handler and the notification's Stop
             reach it. -->
        <service
            android:name=".notifications.RingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Stay connected: one open connection to the household's server for
             instant alerts without Firebase. Not exported: only the app starts
             it. -->
        <service
            android:name=".notifications.StayConnectedService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a connection to the user's own self-hosted household server so its alerts arrive instantly, without Firebase." />
        </service>

        <!-- "Keep Our Home running" (notifications/CloseGuard): an Accessibility
             service turned on by hand in Android's settings. Holds Stay
             connected's connection while on, and on a phone an adult looks
             after closes Our Home's App info, Device admin page and uninstall
             prompt. Only the system binds it. -->
        <service
            android:name=".notifications.CloseGuardService"
            android:exported="false"
            android:label="@string/close_guard_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            tools:ignore="AccessibilityPolicy">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/close_guard" />
        </service>

        <!-- "Keep Our Home on this phone" (notifications/CloseGuard): a Device
             admin with no policies of its own. While active, Android blocks
             uninstalling Our Home until it's unlocked with the parent PIN. -->
        <receiver
            android:name=".notifications.CloseGuardAdminReceiver"
            android:description="@string/close_guard_admin_description"
            android:exported="true"
            android:label="@string/close_guard_admin_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Hands a downloaded app update to Android's installer (AppUpdate).
             Shares only cache/updates/, and only by a one-time read grant. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- Instant alerts: the server's content-free "sync" pushes and FCM token
             changes. Only active when the build has google-services.json. -->
        <service
            android:name=".notifications.PushMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
